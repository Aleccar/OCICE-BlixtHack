@model CreateTopicModalVM

<!-- Button trigger modal -->
<button type="button" class="btn btn-standard-colour" data-bs-toggle="modal" data-bs-target="#createTopicModal">
    Skapa Ny Tråd
</button>

<!-- Modal -->
<div class="modal fade" id="createTopicModal" tabindex="-1" aria-labelledby="createTopicModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-10" id="createTopicModalLabel">Ny Tråd</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body container">
                <form method="post" asp-controller="Home" asp-action="AddTopic">
                    <div class="row">
                        <div class="col">
                            <div class="input-left mb-2">
                                <label asp-for="CreateTopicDTO.categoryId"
                                       class="control-label">Trådkategori</label><br/>
                            </div>
                            <select asp-for="CreateTopicDTO.categoryId"
                                    asp-items="@(new SelectList(Model.Categories, "Id", "Title"))" class="form-control">
                                <option value="">-- Välj kategori --</option>
                            </select><br/>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col">
                            <div class="input-left mb-2 float-end">
                                <label asp-for="CreateTopicDTO.Title" class="control-label">Rubrik</label><br/>
                            </div>
                            <input asp-for="CreateTopicDTO.Title" type="text" class="form-control"
                                   placeholder="Skriv Rubrik..."><br/>
                            <span asp-validation-for="CreateTopicDTO.Title" style="color:red"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col">
                            <div class="input-left mb-2">
                                <label asp-for="CreateTopicDTO.BodyText"
                                       class="control-label">Trådtext</label><br/>
                            </div>
                            <textarea asp-for="CreateTopicDTO.BodyText" class="form-control" rows="10"
                                      placeholder="Skriv trådtext..."></textarea>
                            <span asp-validation-for="CreateTopicDTO.BodyText" style="color:red"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col">
                            <div class="input-left mb-2 float-end">
                                <label asp-for="CreateTopicDTO.Alias" class="control-label">Alias</label><br/>
                            </div>
                            <input asp-for="CreateTopicDTO.Alias" type="text" class="form-control"
                                   placeholder="Skriv ditt alias..."><br/>
                            <span asp-validation-for="CreateTopicDTO.Alias" style="color:red"></span>
                        </div>
                    </div>

                    <div class="form-group text-center">
                        <input type="submit" class="btn btn-lg btn-standard-colour mt-3" value="Skapa Inlägg">
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>