@model CreateTopicModalVM

<!-- Button trigger modal -->
<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTopicModal">
    Skapa Ny Tråd
</button>

<!-- Modal -->
<div class="modal fade" id="createTopicModal" tabindex="-1"
     aria-labelledby="createTopicModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header text-center">
                <h1 class="modal-title fs-5" id="createTopicModalLabel">Ny Tråd</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body container">
                <form method="post" asp-controller="Home" asp-action="AddTopic">
                    <div class="row">
                        <div class="col">
                            <div class="input-left mb-2">
                                <label asp-for="CreateTopicDTO.Title" class="control-label">Rubrik:</label><br/>
                            </div>
                            <input asp-for="CreateTopicDTO.Title" type="text" class="form-control" placeholder="Skriv Rubrik..."><br/>
                            <span asp-validation-for="CreateTopicDTO.Title" style="color:red"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col">
                            <div class="input-left mb-2">
                                <label asp-for="CreateTopicDTO.BodyText" class="control-label">Text:</label><br/>
                            </div>
                            <textarea asp-for="CreateTopicDTO.BodyText" class="form-control" rows="10" placeholder="Skriv trådtext..."></textarea>
                            <span asp-validation-for="CreateTopicDTO.BodyText" style="color:red"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col">
                            <div class="input-left mb-2">
                                <label asp-for="CreateTopicDTO.Alias">Alias:</label><br/>
                            </div>
                            <input asp-for="CreateTopicDTO.Alias" type="text" class="form-control" placeholder="Skriv ditt alias..."><br/>
                            <span asp-validation-for="CreateTopicDTO.BodyText" style="color:red"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col">
                            <div class="input-left mb-2">
                                <label asp-for="CreateTopicDTO.categoryId">Kategori:</label><br/>
                            </div>
                            <select asp-for="CreateTopicDTO.categoryId" asp-items="@(new SelectList(Model.Categories, "Id", "Title"))" class="form-control">
                                <option value="">-- Välj kategori --</option>
                            </select><br/>
                        </div>

                        <div class="form-group">
                            <input type="submit" class="btn btn-success float-end mt-3" value="Skapa">
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>