<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OCICE_BlixtHack</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OCICE_BlixtHack.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="mx-5">
        <div class="container text-center">
            <div class="row">
                <div class="col-5"><h1 class="display-4 text-center">BlixtHack Forum</h1></div>
                <div class="col d-flex align-items-center"><span class="dot"></span></div>
                <div class="col d-flex align-items-center"><span class="dot"></span></div>
                <div class="col d-flex align-items-center"><span class="dot"></span></div>
                <div class="col d-flex align-items-center"><span class="dot"></span></div>
                <div class="col d-flex align-items-center"><span class="dot"></span></div>
                <div class="col d-flex align-items-center"><span class="dot"></span></div>
                <div class="col d-flex align-items-center"><span class="dot"></span></div>
                <div class="col d-flex align-items-center"><span class="dot pink"></span></div>
            </div>
        </div>
        <nav class="navbar navbar-expand-sm box-shadow">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nat-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Categories">Kategorier</a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="layout mx-5">
        <aside class="sidebar">
            @await Component.InvokeAsync("CategoriesSidebar")
        </aside>

        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="footer text-muted @* start-50 translate-middle-x *@">
        <div class="container">
            &copy; 2026 - OCICE_BlixtHack - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
