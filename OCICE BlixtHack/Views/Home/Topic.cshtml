@model TopicResponseVM

<!DOCTYPE html>

<html lang="se-sv">
<head>
    <title>@Model.Topic</title>
    <link rel="stylesheet" href="~/css/Category.css" asp-append-version="true" />
</head>
<body>
    <div class="align-content-center ">

        <article class="card">

            <h1 class="card-header card-title">
                @Model.Topic.Title
            </h1>
            <div class="card-body">

                <p class="mt-1">
                    @Model.Topic.BodyText
                </p>

                <div class="card-footer mt-1 container">
                    <div class="row">
                        <div class="col">
                            <p>Skrivet av: @Model.Topic.Alias</p>
                        </div>
                        <div class="col text-center">
                            <p>Visningar: @Model.Topic.Views</p>
                        </div>
                        <div class="col text-end">
                            <p>@Model.Topic.CreatedAt.ToShortDateString() @Model.Topic.CreatedAt.ToShortTimeString()</p>
                        </div>
                    </div>
                </div>

            </div>
        </article>

        <button type="button" class="btn btn-primary mt-2" data-bs-toggle="modal" data-bs-target="#createResponseModal">Skriv Svar</button>

        <div class="modal fade" id="createResponseModal" tabindex="-1" aria-labelledby="createResponseModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="createResponseModalLabel">Skriv Svar</h2>
                    </div>

                    <div class="modal-body container">
                        <form method="post">
                            <div class="row">
                                <div class="col">
                                    <div class="input-left mb-2">
                                        <label asp-for="TopicResponseCreateDTO.CommentBody" class="control-label"></label>
                                    </div>
                                    <input asp-for="TopicResponseCreateDTO.CommentBody" type="text" class="form-control" placeholder="Skriv ett svar här..." />
                                    <span asp-validation-for="TopicResponseCreateDTO.CommentBody" style="color:red" class="field-validation-error"></span>
                                </div>

                            </div>
                            <div class="row">
                                <div class="col">
                                    <div class="input-left mb-2">
                                        <label asp-for="TopicResponseCreateDTO.ResponderAlias" class="control-label"></label>
                                    </div>
                                    <input asp-for="TopicResponseCreateDTO.ResponderAlias" type="text" class="form-control" placeholder="Alias"/>
                                    <span asp-validation-for="TopicResponseCreateDTO.ResponderAlias" style="color:red" class="field-validation-error"></span>
                                </div>
                            </div>

                            <input type="hidden" asp-for="TopicResponseCreateDTO.TopicParentId" value="@Model.Topic.Id"/>

                            <div class="form-group">
                                <button type="submit" class="btn btn-success mt-3">
                                    Spara Svar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        @foreach (var reply in Model.TopicResponses)
        {
            <article class="card mt-2">
                <p class="card-body">
                    @reply.CommentBody
                </p>

                <div class="card-footer mt-1 container">
                    <div class="row">
                        <div class="col">
                            <p>Respondent: @reply.ResponderAlias</p>
                        </div>
                        <div class="col text-end">
                            <p>@reply.CreatedAt.ToShortDateString() @reply.CreatedAt.ToShortTimeString()</p>
                        </div>
                    </div>
                </div>
            </article>
        }

    </div>
</body>
</html>