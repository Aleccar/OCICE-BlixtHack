@model TopicResponseVM

<!DOCTYPE html>

<html lang="se-sv">
<head>
    <title>@Model.Topic</title>
    <link rel="stylesheet" href="~/css/Category.css" asp-append-version="true"/>
</head>
<body>
    <div class="align-content-center ">

        <article class="card">

            <h1 class="card-header card-title">
                @Model.Topic.Title
            </h1>
            <div class="card-body">

                <p class="mt-1">
                    @Model.Topic.BodyText
                </p>

                <div class="card-footer mt-1 container">
                    <div class="row">
                        <div class="col">
                            <p>Skrivet av: @Model.Topic.Alias</p>
                        </div>
                        <div class="col text-end">
                            <p>@Model.Topic.CreatedAt.ToShortDateString() @Model.Topic.CreatedAt.ToShortTimeString()</p>
                        </div>
                    </div>
                </div>

            </div>
        </article>

        @foreach (var reply in Model.TopicResponses)
        {
            <article class="card">
                <p class="card-body">
                    @reply.CommentBody
                </p>

                <div class="card-footer mt-1">
                    <p>@reply.ResponderAlias</p>
                    <p>@reply.CreatedAt.ToShortDateString() @reply.CreatedAt.ToShortTimeString()</p>
                </div>
            </article>
        }

    </div>
</body>
</html>