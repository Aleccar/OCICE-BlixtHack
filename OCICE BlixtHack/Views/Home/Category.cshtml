@model TopicVM

<!DOCTYPE html>

<html lang="se-sv">
<head>
    <title>@Model.CategoryName</title>
    <link rel="stylesheet" href="~/css/Category.css" asp-append-version="true" />
</head>
<body>
    <div>
        <h1>@Model.CategoryName</h1>
        <table>
            <tr>
                <th>Rubrik</th>
                <th>Skrivet av</th>
                <th>Datum</th>
            </tr>
            @foreach (var topic in Model.Topics)
            {
                <tr>
                    <td><a asp-action="Topic" asp-controller="Home" asp-route-topicId="@topic.Id">@topic.Title</a></td>
                    <td>@topic.Alias</td>
                    <td>@topic.CreatedAt.ToShortDateString() @topic.CreatedAt.ToShortTimeString()</td>
                </tr>
            }
        </table>
    </div>
</body>
</html>