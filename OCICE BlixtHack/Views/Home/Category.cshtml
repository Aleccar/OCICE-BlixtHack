@model ThreadsVM

@{
 //   Layout = _Layout;
}

<!DOCTYPE html>

<html lang="se-sv">
<head>
    <title>@Model.CategoryName</title>
</head>
<body>
<div>
    <h1>@Model.CategoryName</h1>
    
    <ul>
        @foreach (var thread in Model.Threads)
        {
            <li>@thread.Title</li>
        }
    </ul>
    
    Threads: @Model.Threads.Count()
</div>
</body>
</html>