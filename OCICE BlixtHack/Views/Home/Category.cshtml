@model TopicVM

<!DOCTYPE html>

<html lang="se-sv">
<head>
    <title>@Model.CategoryName</title>
    <link rel="stylesheet" href="~/css/PageView.css" asp-append-version="true" />
</head>
<body>
    <div>
        <h2 class="text-center">@Model.CategoryName</h2>
        <table class="table table-hover table-borderless transparent-table">
            <thead>
            <tr>
                <th>Rubrik</th>
                <th>Skrivet av</th>
                <th class="text-center">Visningar</th>
                <th class="text-center">Antal Svar</th>
                <th></th>
                <th>Datum</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var topic in Model.Topics)
            {
                <tr class="position-relative ">

                    <td>@topic.Title</td>
                    <td>@topic.Alias</td>
                    <td class="text-center">@topic.Views</td>
                    <td class="text-center">@topic.TopicResponses.Count()</td>
                    <td><a asp-action="Topic" asp-controller="Home" asp-route-topicId="@topic.Id" asp-route-incrementViews="true" class="stretched-link"></a></td>
                    <td>@topic.CreatedAt.ToShortDateString() @topic.CreatedAt.ToShortTimeString()</td>

                </tr>
            }
            </tbody>
        </table>
    </div>
</body>
</html>